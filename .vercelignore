# Vercel Free Tier (Hobby) Deployment Ignore Configuration
# Ensures ONLY lightweight static web files + ultra-compressed WebP 3D textures (~357 KB total) are deployed
# Excludes all heavy PDFs (42 MB), MP4 videos (17.8 MB), raw PNGs (5.3 MB), and Python engines

# Heavy binary, video, and raw PNG image files
*.pdf
**/*.pdf
data/*.pdf
*.mp4
**/*.mp4
assets/videos/
assets/isometric/
images/

# Motion graphics & local dev folders
dp365-motion-graphics/
out/
web/

# Python virtual environments, scripts, and runtime caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
agents/
crypto_engine/
scripts/
dailypost.py
deploy_to_github.py
genius_cli.py
upload_images.py
patch*.py

# Repo & internal metadata not needed by Vercel CDN
.github/
.agent/
.agents/
data/origin_*.html
data/master_vault.json
data/index.html
stitch-config.json
status
joule_cache.json
.env
.env.*
